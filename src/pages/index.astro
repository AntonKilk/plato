---
import MainLayout from '../layouts/MainLayout.astro';
import Navigation from '../components/Navigation';
import CaveIntro from '../components/CaveIntro';
import Section from '../components/Section';
import Events from '../components/Events';
import Footer from '../components/Footer';

import '../styles/global.css';
import About from '../components/About';
---

<MainLayout title="Academia Platonica">
  <div id="home" class="home-section">
    <Navigation client:load />
    <CaveIntro client:load />
  </div>
  
  <main>
    <Section id="about" title="О школе" subtitle="Academia Platonica — площадка для живой мысли. Мы изучаем философию, историю науки и античную культуру, чтобы лучше понимать себя и мир сегодня">
      <About />
    </Section>
    <Section id="events" title="События" subtitle="Встречи, дискуссии и лекции нашего философского клуба" light={true}>
      <Events />
    </Section>
  </main>
  <Footer client:load />
</MainLayout>

<style>
  .home-section {
    height: 100vh;
    position: relative;
    overflow: hidden;
  }
</style>
