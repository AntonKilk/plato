---
import MainLayout from '../layouts/MainLayout.astro';
import Navigation from '../components/Navigation';
import CaveIntro from '../components/CaveIntro';
import Section from '../components/Section';
import Events from '../components/Events';
import Footer from '../components/Footer';

import '../styles/global.css';
---

<MainLayout title="Платоновский клуб — Путь от теней к истине">
  <div id="home" class="home-section">
    <Navigation client:load />
    <CaveIntro client:load />
  </div>
  
  <main>
    <Section id="events" title="События" subtitle="Встречи, дискуссии и лекции нашего философского клуба" light={true}>
      <Events client:visible />
    </Section>
  </main>
  
  <Footer client:load />
</MainLayout>

<style>
  .home-section {
    height: 100vh;
    position: relative;
    overflow: hidden;
  }
</style>
